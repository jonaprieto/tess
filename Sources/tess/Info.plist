<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Linked into the binary (Package.swift), so macOS can ask once before tess talks to a browser. -->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.jonaprieto.tess</string>
    <key>CFBundleName</key>
    <string>tess</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>tess lists and selects browser tabs in its picker.</string>
</dict>
</plist>
